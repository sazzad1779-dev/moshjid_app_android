# Copy to .env and fill real values. Never commit .env.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Hidden service account for background Supabase writes.
# App UI stays PIN-only; the app signs in silently with these.
# Create the user in Supabase Dashboard -> Authentication -> Add user,
# then link it: update profiles set auth_user_id = '<auth uuid>' where ...;
SERVICE_EMAIL=mosque-device@example.com
SERVICE_PASSWORD=change-me-to-a-strong-password
# Optional fallback for transactions.entered_by if profile lookup fails.
ENTERED_BY_ID=00000000-0000-0000-0000-00000000000

# Optional: direct Postgres connection. BYPASSES RLS entirely, so it can read and
# write rows the REST API hides (e.g. other users' profiles).
# Dashboard -> Database -> Connection string. Must be the real password.
# DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: service_role API key. Bypasses RLS for REST calls. Preferred over
# DATABASE_URL because it needs no driver. Dashboard -> Project Settings -> API Keys.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
